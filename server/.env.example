# Server port (default: 3000)
PORT=3000

# Bearer token for /api/* routes. Leave empty to disable auth (dev only).
DANTE_API_TOKEN=

# SQLite database file (default: dante.db)
DANTE_DB_PATH=dante.db

# Model, until it is configurable in the settings.
# DANTE_MODEL_TYPE is "openai-compatible" (default) or "anthropic".
DANTE_MODEL_TYPE=
DANTE_MODEL_URL=
DANTE_MODEL_ID=
DANTE_MODEL_API_KEY=

# MCP servers (Streamable HTTP), comma-separated. Leave empty for no tools.
DANTE_MCP_URLS=

# Local models via `task llama` (llama-server in router mode):
# DANTE_MODEL_URL=http://localhost:9931/v1
# DANTE_MODEL_ID=<section name from llama.cpp/models.ini>
