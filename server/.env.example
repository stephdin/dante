# Server port (default: 3000)
PORT=3000

# Bearer token for /api/* routes. Leave empty to disable auth (dev only).
DANTE_API_TOKEN=

# SQLite database file (default: dante.db)
DANTE_DB_PATH=dante.db

# Model, until it is configurable in the settings.
# DANTE_MODEL_TYPE is "openai-compatible" (default) or "anthropic".
DANTE_MODEL_TYPE=openai-compatible
DANTE_MODEL_URL=https://opencode.ai/zen/go/v1
DANTE_MODEL_ID=deepseek-v4-flash
DANTE_MODEL_API_KEY=
